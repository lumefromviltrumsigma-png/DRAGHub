-- 2-ci Role ESP Logic (Hider -> Mavi, Seeker -> Qırmızı, Ad və Can ilə)
local roleEspEnabled = false
local roleConnections = {}

local function setupRoleESP(player)
    if player == LocalPlayer then return end

    local function applyRole(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hrp or not hum then return end

        local isHider = player:GetAttribute("IsHider") or (player.Team and player.Team.Name:lower():find("hider"))
        local isSeeker = player:GetAttribute("IsHunter") or player:GetAttribute("IsSeeker") or (player.Team and (player.Team.Name:lower():find("seeker") or player.Team.Name:lower():find("hunter")))

        local roleColor = Color3.fromRGB(0, 150, 255) -- Mavi (Hider)
        local roleTextName = "HIDER"

        if isSeeker or (player.Team and player.Team.Name:lower():find("seeker")) then
            roleColor = Color3.fromRGB(255, 50, 50) -- Qırmızı (Seeker)
            roleTextName = "SEEKER"
        end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "RoleESP_BB"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 120, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.Parent = hrp
        billboard.Enabled = roleEspEnabled

        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = billboard
        textLabel.BackgroundTransparency = 1
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.Font = Enum.Font.Code
        textLabel.TextColor3 = roleColor
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 12

        local highlight = Instance.new("Highlight")
        highlight.Name = "RoleESP_HL"
        highlight.Adornee = char
        highlight.FillTransparency = 0.5
        highlight.FillColor = roleColor
        highlight.OutlineColor = roleColor
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        highlight.Enabled = roleEspEnabled

        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not char or not hum or hum.Health <= 0 then
                billboard:Destroy()
                if highlight then highlight:Destroy() end
                if conn then conn:Disconnect() end
                return
            end
            local curHp = math.floor(hum.Health)
            local maxHp = math.floor(hum.MaxHealth)
            textLabel.Text = player.Name .. " [" .. roleTextName .. "]\nHP: " .. curHp .. "/" .. maxHp
        end)
        table.insert(roleConnections, conn)
    end

    if player.Character then
        applyRole(player.Character)
    end
    table.insert(roleConnections, player.CharacterAdded:Connect(applyRole))
end

RoleESPButton.MouseButton1Click:Connect(function()
    roleEspEnabled = not roleEspEnabled
    if roleEspEnabled then
        RoleESPButton.Text = "Role ESP: ON"
        RoleESPButton.TextColor3 = Color3.fromRGB(50, 255, 50)
        RoleESPButton.BorderColor3 = Color3.fromRGB(50, 255, 50)
        
        for _, p in ipairs(Players:GetPlayers()) do
