-- 1-ci ESP Logic (Can rəngləri ilə, adsız)
local espEnabled = false
local espConnections = {}

local function createESP(player)
    if player == LocalPlayer then return end
    
    local function setupCharacter(char)
        local humanoidRootPart = char:WaitForChild("HumanoidRootPart", 5)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if not humanoidRootPart or not humanoid then return end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "CustomESP"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 80, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.Parent = humanoidRootPart

        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = billboard
        textLabel.BackgroundTransparency = 1
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.Font = Enum.Font.Code
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 13

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Adornee = char
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        highlight.Enabled = espEnabled

        billboard.Enabled = espEnabled

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not char or not humanoid or humanoid.Health <= 0 then
                billboard:Destroy()
                if highlight then highlight:Destroy() end
                if connection then connection:Disconnect() end
                return
            end

            local currentHP = math.floor(humanoid.Health)
            local maxHP = math.floor(humanoid.MaxHealth)
            local healthPercent = currentHP / maxHP

            local healthColor = Color3.fromRGB(0, 255, 0) -- Yaşıl (Full)
            if healthPercent <= 0.25 then
                healthColor = Color3.fromRGB(120, 0, 0) -- Tünd Qırmızı (<25%)
            elseif healthPercent <= 0.49 then
                healthColor = Color3.fromRGB(255, 0, 0) -- Qırmızı (25% - 49%)
            elseif healthPercent < 1 then
                healthColor = Color3.fromRGB(255, 255, 0) -- Sarı (50% - 99%)
            end

            textLabel.TextColor3 = healthColor
            highlight.OutlineColor = healthColor
            textLabel.Text = currentHP .. "/" .. maxHP
        end)
        
        table.insert(espConnections, connection)
    end

    if player.Character then
        setupCharacter(player.Character)
    end
    table.insert(espConnections, player.CharacterAdded:Connect(setupCharacter))
end

table.insert(espConnections, Players.PlayerAdded:Connect(createESP))

