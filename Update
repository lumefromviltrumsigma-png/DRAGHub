-- 5-ci: Arcade Auto Farm Mexanizmi
local ArcadeAutoFarmEnabled = false
local ArcadeAutoFarmTask = nil
local ArcadeCurrentGame = nil
local ArcadeConsoleCache = nil

local function getArcadeConsole()
    if ArcadeConsoleCache and ArcadeConsoleCache.Parent then
        return ArcadeConsoleCache
    end

    for _, descendant in workspace:GetDescendants() do
        local screen = descendant:FindFirstChild("Screen")
        if screen and screen:FindFirstChild("SurfaceGui") then
            ArcadeConsoleCache = descendant
            return descendant
        end
    end
    return nil
end

local function runArcadeFarm()
    local ok, PlayableArcadeGame = pcall(function()
        return require(ReplicatedStorage.Modules.PlayableArcadeGame)
    end)

    if not ok or not PlayableArcadeGame then return end
    local arcadeConsole = getArcadeConsole()
    if not arcadeConsole then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    if ArcadeCurrentGame then
        pcall(function()
            ArcadeCurrentGame.Stopping = true
            ArcadeCurrentGame:Destroy()
        end)
        ArcadeCurrentGame = nil
    end

    local gameObject = PlayableArcadeGame.new(arcadeConsole, humanoidRootPart)
    ArcadeCurrentGame = gameObject
    gameObject:start()

    local startTime = os.clock()
    while gameObject.State ~= "Running" and os.clock() - startTime < 3 do
        if not ArcadeAutoFarmEnabled then return end
        task.wait()
    end

    if not ArcadeAutoFarmEnabled then return end
    if gameObject.State ~= "Running" then
        pcall(function() gameObject:Destroy() end)
        ArcadeCurrentGame = nil
        return
    end

    gameObject.Score = 4499
    if gameObject.ScoreLabel then
        gameObject.ScoreLabel.Text = "Score: 4499"
    end

    table.clear(gameObject.CalculateScore)
    for i = 1, 99 do
        table.insert(gameObject.CalculateScore, "Coin")
    end

    gameObject:win("You Won! Congrats! :D")
end

local function toggleArcadeAutoFarm(enabled)
    ArcadeAutoFarmEnabled = enabled and true or false

    if not ArcadeAutoFarmEnabled then
        if ArcadeAutoFarmTask then
            pcall(function() task.cancel(ArcadeAutoFarmTask) end)
            ArcadeAutoFarmTask = nil
        end
        if ArcadeCurrentGame then
            pcall(function()
                ArcadeCurrentGame.Stopping = true
                ArcadeCurrentGame:Destroy()
            end)
            ArcadeCurrentGame = nil
        end
        return true
    end

    ArcadeAutoFarmTask = task.spawn(function()
        while ArcadeAutoFarmEnabled do
            pcall(runArcadeFarm)
            if ArcadeAutoFarmEnabled then
                task.wait(1)
            else
                break
            end
        end
        ArcadeAutoFarmTask = nil
    end)
    return true
end

ArcadeFarmButton.MouseButton1Click:Connect(function()
    local newState = not ArcadeAutoFarmEnabled
    toggleArcadeAutoFarm(newState)

    if newState then
        ArcadeFarmButton.Text = "Arcade Auto Farm: ON"
        ArcadeFarmButton.TextColor3 = Color3.fromRGB(0, 255, 255)
        ArcadeFarmButton.BorderColor3 = Color3.fromRGB(0, 255, 255)
